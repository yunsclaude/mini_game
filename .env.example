# 환경변수 예시 파일입니다.
#
# 사용법: 이 파일을 복사해 .env.local 을 만들고 필요한 값을 채우세요.
#   cp .env.example .env.local
#
# .env 와 .env.local 은 .gitignore 에 포함되어 GitHub 에 올라가지 않습니다.
# 이 파일(.env.example)에는 절대 실제 API 키나 비밀번호를 적지 마세요.
# 값이 없어도 템플릿의 로컬 실행과 Docker 빌드는 정상 동작합니다.

# 실행 모드: development | production
NODE_ENV=development

# 브라우저에도 노출되는 공개 주소입니다.
# NEXT_PUBLIC_ 으로 시작하는 값은 누구나 볼 수 있으므로 비밀값을 넣지 마세요.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 데이터베이스 접속 주소입니다. project.json 의 database 가 true 일 때만 씁니다.
#
# 대부분은 이 값을 직접 적을 일이 없습니다.
#   docker compose up  -> compose.yaml 이 알아서 넣어 줍니다
#   배포               -> 서버가 프로젝트별로 만들어 넣어 줍니다
#
# npm run dev 로 Docker 없이 개발하면서 DB 를 쓰고 싶을 때만 .env.local 에 적으세요.
# 이때 아래처럼 DB 컨테이너만 따로 띄우면 됩니다.
#   docker compose up -d db
#   그리고 compose.yaml 의 db 서비스에서 ports 주석을 푸세요.
#
# DATABASE_URL=postgresql://app:localdev@localhost:5432/app
